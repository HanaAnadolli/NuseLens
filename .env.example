# .env.example
# === REQUIRED ===
DATABASE_URL="postgresql://postgres.qfihnxjhsalhbdimexpp:YOUR_DATABASE_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.qfihnxjhsalhbdimexpp:YOUR_DATABASE_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
AUTH_SECRET=

# === APP ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="NuseLens"

# === SUPABASE ===
NEXT_PUBLIC_SUPABASE_URL=https://qfihnxjhsalhbdimexpp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# === UPLOADS ===
PHOTO_STORAGE=supabase
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE_MB=8
MAX_FILES_PER_UPLOAD=10

# === GOOGLE DRIVE OPTIONAL ===
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# Alternative to GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === OPTIONAL ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
